	partition Date_Table = calculated
		mode: import
		source =
				
				VAR MinDate =
				    MIN(Clean_sales_data[Lead_Date])
				
				VAR MaxDate =
				    MAX(Clean_sales_data[Close_Date])
				
				RETURN
				    CALENDAR(
				        DATE(YEAR(MinDate), 1, 1),
				        DATE(YEAR(MaxDate), 12, 31)
				    )

