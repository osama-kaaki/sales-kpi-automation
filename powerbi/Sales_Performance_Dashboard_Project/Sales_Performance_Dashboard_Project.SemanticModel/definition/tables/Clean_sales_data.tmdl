		lineageTag: 5e57e831-1a3c-4cb1-80c8-d0ddf9754bdd

	measure 'Tooltip Performance Status' =
			
			IF(
			    HASONEVALUE(Dim_Salesperson[Salesperson]),
			    SWITCH(
			        TRUE(),
			
			        [Has Breakdown Filter],
			            "Not evaluated",
			
			        NOT([Is Target Period Selected]),
			            "Not evaluated",
			
			        ISBLANK([Target Achievement %]),
			            "Not evaluated",
			
			        [Target Achievement %] >= 0.70,
			            "On Track",
			
			        [Target Achievement %] >= 0.50,
			            "At Risk",
			
			        "Critical"
			    ),
			    BLANK()
			)
		lineageTag: 4da94c4c-0a4d-4a04-8aed-aa3748f1340e

	measure 'Tooltip Intervention Priority' =
			
			VAR TooltipVsAveragePct =
			    DIVIDE(
			        [Total Sales] - [Average Sales per Salesperson],
			        [Average Sales per Salesperson]
			    )
			
			RETURN
			IF(
			    HASONEVALUE(Dim_Salesperson[Salesperson]),
			    SWITCH(
			        TRUE(),
			
			        [Has Breakdown Filter],
			            "Not evaluated",
			
			        NOT([Is Target Period Selected]),
			            "Not evaluated",
			
			        ISBLANK([Target Achievement %]),
			            "Not evaluated",
			
			        [Target Achievement %] < 0.50
			            && TooltipVsAveragePct < -0.10,
			            "Immediate Intervention",
			
			        [Target Achievement %] < 0.70
			            || TooltipVsAveragePct < -0.10,
			            "Needs Attention",
			
			        "Healthy"
			    ),
			    BLANK()
			)
		lineageTag: eb650cb2-1f18-4397-9ae2-4282dde87ccb

	measure 'Sales YTD' =
			
			TOTALYTD(
			    [Total Sales],
			    Date_Table[Date]
			)
		formatString: 0
		lineageTag: ae0f52dc-14e8-40ad-a6ae-4e2ff50484f2

	measure 'Previous Month Sales' =
			
			VAR AnchorDate =
			    MAX(Date_Table[Date])
			
			VAR PreviousMonthStart =
			    EOMONTH(AnchorDate, -2) + 1
			
			VAR PreviousMonthEnd =
			    EOMONTH(AnchorDate, -1)
			
			RETURN
			CALCULATE(
			    [Total Sales],
			    REMOVEFILTERS(Date_Table),
			    DATESBETWEEN(
			        Date_Table[Date],
			        PreviousMonthStart,
			        PreviousMonthEnd
			    )
			)
		formatString: 0
		lineageTag: 8e266162-3f08-4f3f-b355-e1ca3edf2301

	measure 'MoM Growth %' =
			
			VAR CurrentSales =
			    [Total Sales]
			
			VAR PreviousSales =
			    [Previous Month Sales]
			
			RETURN
			IF(
			    ISBLANK(CurrentSales) ||
			    ISBLANK(PreviousSales),
			    BLANK(),
			    DIVIDE(
			        CurrentSales - PreviousSales,
			        PreviousSales
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bb33afde-a003-469b-87e3-79bc0176f92e

	measure 'Sales MTD' =
			
			TOTALMTD(
			    [Total Sales],
			    Date_Table[Date]
			)
		formatString: 0
		lineageTag: f34ac321-4480-4be1-918c-54a3087c5761

	measure 'Lead Created' =
			
			[Total Leads]
		formatString: 0
		lineageTag: 32da7a13-d0bd-4252-9cfc-e4f881942555

	measure 'Show Selected Salesperson' =
			
			VAR CurrentSalesperson =
			    SELECTEDVALUE(Dim_Salesperson[Salesperson])
			
			RETURN
			IF(
			    NOT ISFILTERED(Salesperson_Filter[Salesperson])
			        || CurrentSalesperson
			            IN VALUES(Salesperson_Filter[Salesperson]),
			    1,
			    0
			)
		formatString: 0
		lineageTag: be712d5a-e13f-4ff1-b33a-422ce9b670be

	measure 'Has Breakdown Filter' =
			
			VAR CurrentRegions =
			    COUNTROWS(
			        VALUES(Clean_sales_data[Region])
			    )
			
			VAR AvailableRegions =
			    CALCULATE(
			        COUNTROWS(
			            VALUES(Clean_sales_data[Region])
			        ),
			        REMOVEFILTERS(Clean_sales_data[Region])
			    )
			
			VAR CurrentLeadSources =
			    COUNTROWS(
			        VALUES(Clean_sales_data[Lead_Source])
			    )
			
			VAR AvailableLeadSources =
			    CALCULATE(
			        COUNTROWS(
			            VALUES(Clean_sales_data[Lead_Source])
			        ),
			        REMOVEFILTERS(Clean_sales_data[Lead_Source])
			    )
			
			VAR CurrentProducts =
			    COUNTROWS(
			        VALUES(Clean_sales_data[Product_Service])
			    )
			
			VAR AvailableProducts =
			    CALCULATE(
			        COUNTROWS(
			            VALUES(Clean_sales_data[Product_Service])
			        ),
			        REMOVEFILTERS(Clean_sales_data[Product_Service])
			    )
			
			RETURN
			    CurrentRegions < AvailableRegions
			        || CurrentLeadSources < AvailableLeadSources
			        || CurrentProducts < AvailableProducts
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 6614e958-2268-4b5d-a7fb-68e1128eadb4

