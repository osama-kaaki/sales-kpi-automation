			    "Critical", "#C62828",
			    "Not evaluated", "#6B7280",
			    "#1F2937"
			)
		lineageTag: 671821b7-5da0-4e1b-ad62-0303948b0c5e

	measure 'Intervention Priority Color' =
			
			SWITCH(
			    [Tooltip Intervention Priority],
			    "Healthy", "#2E7D32",
			    "Needs Attention", "#B26A00",
			    "Immediate Intervention", "#C62828",
			    "Not evaluated", "#6B7280",
			    "#1F2937"
			)
		lineageTag: d1997bf3-f733-4b9b-9dd6-65b9c05b7bfc

	measure 'Is Target Period Selected' =
			
			VAR SelectedStart =
			    MINX(
			        ALLSELECTED(Date_Table[Date]),
			        Date_Table[Date]
			    )
			VAR SelectedEnd =
			    MAXX(
			        ALLSELECTED(Date_Table[Date]),
			        Date_Table[Date]
			    )
			RETURN
			    SelectedStart = DATE(2026, 5, 1)
			        && SelectedEnd = DATE(2026, 6, 30)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 85987c8b-65d7-40c0-a692-4ea9f23c3d36

