table Clean_sales_data
	lineageTag: 34d664aa-09e2-482c-91bb-c1080f8576b4

	measure 'Total Leads' =
			
			COALESCE(
			    CALCULATE(
			        COUNTROWS(Clean_sales_data),
			
			        CROSSFILTER(
			            Date_Table[Date],
			            Clean_sales_data[Close_Date],
			            NONE
			        ),
			
			        USERELATIONSHIP(
			            Date_Table[Date],
			            Clean_sales_data[Lead_Date]
			        )
			    ),
			    0
			)
		formatString: 0
		lineageTag: 485bbf30-227f-4666-b14d-68e7f8c9efc7

	measure 'Won Deals' =
			
			COALESCE(
			    CALCULATE(
			        COUNTROWS(Clean_sales_data),
			        Clean_sales_data[Lead_Status] = "Won"
			    ),
			    0
			)
		formatString: 0
		lineageTag: 0d78655b-d6b4-4137-9a83-77876f3922db

	measure 'Total Sales' =
			
			CALCULATE(
			    SUM(Clean_sales_data[Deal_Value]),
			    Clean_sales_data[Lead_Status] = "Won"
			)
		formatString: #,0
		lineageTag: 31a276e0-8083-4152-a82f-64151d36c672

	measure 'Total Cost' =
			
			CALCULATE(
			    SUM(Clean_sales_data[Cost]),
			    Clean_sales_data[Lead_Status] = "Won"
			)
		formatString: 0
		lineageTag: bb422be7-4967-4c85-9d63-479581e89e13

	measure 'Gross Profit' = [Total Sales] - [Total Cost]
		formatString: 0
		lineageTag: 9e21a835-4f59-4a57-a93b-131a045c98f9

	measure 'Lead Conversion' =
			
			VAR WonLeads =
			    CALCULATE(
			        [Total Leads],
			        Clean_sales_data[Lead_Status] = "Won"
			    )
			RETURN
			    DIVIDE(
			        WonLeads,
			        [Total Leads]
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f558ec7e-41fc-4e52-9276-391609a1bc94

	measure 'Lost Deals' =
			
			COALESCE(
			    CALCULATE(
			        COUNTROWS(Clean_sales_data),
			        Clean_sales_data[Lead_Status] = "Lost"
			    ),
			    0
			)
		formatString: 0
		lineageTag: 9cd52095-6c56-4c13-8bc8-ceefc8716857

	measure 'Closed Deal Win Rate' =
			
			VAR WonCount = [Won Deals]
			VAR LostCount = [Lost Deals]
			VAR ClosedDeals = WonCount + LostCount
			
			RETURN
			IF(
			    ClosedDeals = 0,
			    BLANK(),
			    DIVIDE(WonCount, ClosedDeals)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5fb96a85-8d7a-41b5-be8e-25c95e5324f8

	measure 'Won Sales' =
			
			CALCULATE(
			    [Total Sales],
			    Clean_sales_data[Lead_Status] = "Won"
			)
		formatString: 0
		lineageTag: 799eb14e-3ac7-494f-9505-f5bb299141c3

	measure 'Pipeline Value' =
			
			COALESCE(
			    CALCULATE(
			        SUM(Clean_sales_data[Deal_Value]),
			        CROSSFILTER(
			            Date_Table[Date],
			            Clean_sales_data[Close_Date],
			            NONE
			        ),
			        USERELATIONSHIP(
			            Date_Table[Date],
			            Clean_sales_data[Lead_Date]
			        ),
			        Clean_sales_data[Lead_Status] IN {"Open", "Pending"}
			    ),
			    0
			)
		formatString: 0
		lineageTag: aafd4d4e-3c88-4c46-a755-952fa85e3e7f

	measure 'Average Deal Size' =
			
			DIVIDE(
			    [Total Sales],
			    [Won Deals],
			    0
			)
		lineageTag: 41475dde-11ac-4618-a0a9-62f4fce526f6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit Margin %' =
			
			DIVIDE(
			    [Gross Profit],
			    [Total Sales],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: af8c5987-f9c9-4e62-bdda-d18237655a5d

	measure 'Sales Target' =
			
			IF(
			    [Is Target Period Selected],
			    SUM(Dim_Salesperson[Period_Target]),
			    BLANK()
			)
		formatString: #,0
		lineageTag: 60d04e3c-bb8e-46e2-a6b6-9e381796c6d2

	measure 'Target Achievement %' =
			
			IF(
			    ISBLANK([Sales Target]),
			    BLANK(),
			    DIVIDE(
			        [Total Sales],
			        [Sales Target]
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f8c41474-5431-4def-9283-2a4f47486c85

	measure 'Target Gap' =
			
			VAR TargetValue = [Sales Target]
			RETURN
			    IF(
			        ISBLANK(TargetValue),
			        BLANK(),
			        MAX(
			            TargetValue - [Total Sales],
			            0
			        )
			    )
		formatString: #,0
		lineageTag: ece2e4f1-31ec-4fb5-bd16-1701ac8c04b5

	measure 'Salesperson Rank' =
			
			IF(
			    ISINSCOPE(Dim_Salesperson[Salesperson]),
			
			    VAR Team =
			        CALCULATETABLE(
			            VALUES(Dim_Salesperson[Salesperson]),
			            REMOVEFILTERS(Salesperson_Filter),
			            REMOVEFILTERS(Dim_Salesperson[Salesperson])
			        )
			
			    RETURN
			        RANKX(
			            Team,
			            CALCULATE(
			                [Total Sales],
			                REMOVEFILTERS(Salesperson_Filter)
			            ),
			            [Total Sales],
			            DESC,
			            DENSE
			        )
			)
		formatString: 0
		lineageTag: 9d5537eb-cc03-4f02-a548-7f926d796c2c

	measure 'Performance Status' =
			
			VAR Achievement = [Target Achievement %]
			RETURN
			IF(
			    ISINSCOPE(Dim_Salesperson[Salesperson]),
			    IF(
			        [Has Breakdown Filter]
			            || ISBLANK(Achievement),
			        "Not evaluated",
			        SWITCH(
			            TRUE(),
			            Achievement >= 0.70, "On Track",
			            Achievement >= 0.50, "At Risk",
			            "Critical"
			        )
			    )
			)
		lineageTag: c7240a4c-4683-46f2-a671-82ba36a011c9

	measure 'Top Salesperson' =
			
			VAR TopPerson =
			    TOPN(
			        1,
			        ALLSELECTED(Clean_sales_data[Salesperson]),
			        [Total Sales],
			        DESC
			    )
			    RETURN
			        MAXX(
			            TopPerson,
			            Clean_sales_data[Salesperson]
			        )
		lineageTag: 6103c333-92a3-4517-9e8d-dc9ed71f2e75

	measure 'Top Salesperson Summary' = ```
			
			VAR TopPerson =
			    TOPN(
			        1,
			        ALLSELECTED(Clean_sales_data[Salesperson]),
			        [Total Sales],
			        DESC,
			        Clean_sales_data[Salesperson],
			    )
			VAR PersonName =
			    MAXX(
			        TopPerson,
			        Clean_sales_data[Salesperson]
			    )
			VAR PersonSales = 
			    MAXX(
			        TopPerson,
			        [Total Sales]
			    )
			RETURN
			    PersonName
			    & " - "
			    & FORMAT(DIVIDE(PersonSales, 1000), "0")
			    & "K Sales"
			```
		lineageTag: 3b009364-d907-4f61-9e9e-005ca32ce5f8

	measure 'Top Salesperson Insight' = ```
			
			VAR TopPerson = 
			    TOPN(
			        1,ALLSELECTED(Clean_sales_data[Salesperson]),
			        [Total Sales],
			        DESC,
			        Clean_sales_data[Salesperson],
			        ASC
			    )
			    VAR PersonName = 
			        MAXX(TopPerson,
			        Clean_sales_data[Salesperson]
			        )
			    VAR PersonSales =
			        MAXX(
			            TopPerson,
			            [Total Sales]
			        )
			    VAR PersonAchievement = 
			        CALCULATE(
			            [Target Achievement %],
			            KEEPFILTERS(TopPerson)
			        )
			    VAR PersonStatus = 
			        SWITCH(
			            TRUE(),
			            PersonAchievement >= 0.70, "On Track",
			            PersonAchievement >= 0.50, "At Risk",
			            "Critical"
			        )
			    RETURN
			        PersonName
			        & " - "
			        & FORMAT(DIVIDE(PersonSales, 1000), "0.#")
			        & "K Sales - "
			        & FORMAT(PersonAchievement, "0.0%")
			        & " - "
			        & PersonStatus
			```
		lineageTag: 8eb1b426-7737-400a-bef9-6ccb3334cd03

	measure 'Sales Contribution %' =
			
			VAR TeamSales =
			    CALCULATE(
			        [Total Sales],
			        REMOVEFILTERS(Salesperson_Filter),
			        REMOVEFILTERS(Dim_Salesperson[Salesperson])
			    )
			
			RETURN
			DIVIDE(
			    [Total Sales],
			    TeamSales
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 54f3f586-ef9b-485d-a108-9d0f31dc6eb2

	measure 'Average Sales per Salesperson' =
			
			VAR Team =
			    CALCULATETABLE(
			        VALUES(Dim_Salesperson[Salesperson]),
			        REMOVEFILTERS(Salesperson_Filter),
			        REMOVEFILTERS(Dim_Salesperson[Salesperson])
			    )
			
			RETURN
			AVERAGEX(
			    Team,
			    COALESCE(
			        CALCULATE(
			            [Total Sales],
			            REMOVEFILTERS(Salesperson_Filter)
			        ),
			        0
			    )
			)
		lineageTag: 32831555-21da-43b6-b143-7fcf57fbf803

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales vs Average' =
			
			VAR TeamSales =
			    CALCULATE(
			        [Total Sales],
			        ALLSELECTED(Dim_Salesperson[Salesperson])
			    )
			RETURN
			IF(
			    NOT ISINSCOPE(Dim_Salesperson[Salesperson]),
			    BLANK(),
			    IF(
			        COALESCE(TeamSales, 0) = 0,
			        BLANK(),
			        [Total Sales] - [Average Sales per Salesperson]
			    )
			)
		formatString: #,0
		lineageTag: 6067859c-a19c-4284-882d-79e75ba98d5a

	measure 'Sales vs Average Status' =
			
			VAR TeamSales =
			    CALCULATE(
			        [Total Sales],
			        ALLSELECTED(Dim_Salesperson[Salesperson])
			    )
			RETURN
			IF(
			    ISINSCOPE(Dim_Salesperson[Salesperson]),
			    IF(
			        COALESCE(TeamSales, 0) = 0,
			        "No sales",
			        SWITCH(
			            TRUE(),
			            [Sales vs Average %] > 0, "Above Average",
			            [Sales vs Average %] < 0, "Below Average",
			            "Average"
			        )
			    ),
			    BLANK()
			)
		lineageTag: be908b58-cb09-4601-a879-e3cae293bb3f

	measure 'Sales vs Average %' =
			
			VAR TeamSales =
			    CALCULATE(
			        [Total Sales],
			        ALLSELECTED(Dim_Salesperson[Salesperson])
			    )
			RETURN
			IF(
			    NOT ISINSCOPE(Dim_Salesperson[Salesperson]),
			    BLANK(),
			    IF(
			        COALESCE(TeamSales, 0) = 0,
			        BLANK(),
			        DIVIDE(
			            [Sales vs Average],
			            [Average Sales per Salesperson]
			        )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f3ab3008-53b9-454a-a717-4f114af222e1

	measure 'Intervention Priority' =
			
			VAR PerformanceStatus = [Performance Status]
			VAR Achievement = [Target Achievement %]
			VAR SalesVsAverage = [Sales vs Average %]
			
			RETURN
			IF(
			    ISINSCOPE(Dim_Salesperson[Salesperson]),
			    IF(
			        PerformanceStatus = "Not evaluated"
			            || ISBLANK(Achievement),
			        "Not evaluated",
			        SWITCH(
			            TRUE(),
			            Achievement < 0.50
			                && SalesVsAverage < -0.10,
			                "Immediate Intervention",
			
			            Achievement < 0.70
			                || SalesVsAverage < -0.10,
			                "Needs Attention",
			
			            "Healthy"
			        )
			    )
			)
		lineageTag: feb2ff1e-178c-4f13-91c2-8993d413359e

	measure 'Intervention Color' =
			
			SWITCH(
			    [Intervention Priority],
			    "Healthy", "#D9EAD3",
			    "Needs Attention", "#FFF2CC",
			    "Immediate Intervention", "#F4CCCC",
			    "#FFFFFF"
			)
		lineageTag: 626e7f45-f31b-46b5-925b-035c8f63e184

	measure 'Management Recommendation' =
			
			IF(
			    ISINSCOPE(Dim_Salesperson[Salesperson]),
			    SWITCH(
			        TRUE(),
			
			        [Has Breakdown Filter],
			            "No target allocated for this breakdown",
			
			        NOT([Is Target Period Selected]),
			            "Not evaluated for the selected period",
			
			        [Intervention Priority] = "Healthy",
			            "Maintain performance and pursue upsell opportunities",
			
			        [Intervention Priority] = "Needs Attention",
			            "Review pipeline and focus on high-probability deals",
			
			        [Intervention Priority] = "Immediate Intervention",
			            "Immediate coaching and pipeline recovery required",
			
			        [Intervention Priority] = "Not evaluated",
			            "Not evaluated",
			
			        BLANK()
			    )
			)
		lineageTag: 8ad84186-9b25-4a12-9626-1fd72bc106ce

	measure 'Team Health Summary' = ```
			
			VAR HealthyCount =
			    COALESCE(
			        COUNTROWS(
			            FILTER(
			                VALUES(Clean_sales_data[Salesperson]),
			                CALCULATE([Target Achievement %]) >= 0.70
			        )
			    ),
			    0
			)
			
			VAR AttentionCount =
			    COALESCE(
			        COUNTROWS(
			            FILTER(
			                VALUES(Clean_sales_data[Salesperson]),
			                VAR Achievement = 
			                    CALCULATE([Target Achievement %])
			                RETURN
			                    Achievement >= 0.50 &&
			                    Achievement < 0.70
			        )
			    ),
			    0
			)
			
			VAR CriticalCount =
			    COALESCE(
			        COUNTROWS(
			            FILTER(
			                VALUES(Clean_sales_data[Salesperson]),
			                CALCULATE([Target Achievement %]) < 0.50
			        )
			    ),
			    0
			)
			
			    RETURN
			        "Team Health: "
			        & HealthyCount & " Healthy | "
			        & AttentionCount & " Need Attention | "
			        & CriticalCount & " Critical"
			```
		lineageTag: 9eb49f2a-8008-47a6-8c46-0d73f0c5e4df

	measure 'Salesperson Detail Title' =
			
